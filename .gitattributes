# Normalize line endings: text files checked out with LF, binary files untouched.
* text=auto eol=lf

# Source files are always text.
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.hbs  text eol=lf
*.css  text eol=lf
*.md   text eol=lf

# Binary assets.
*.png  binary
*.jpg  binary
*.pdf  binary
